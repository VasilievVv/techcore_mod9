&НаКлиенте
Процедура СоздатьТестовыеДанные(Команда)
    
    
    Сообщить("Начинаю создание тестовых данных...");
	
	// Создаем товары
	СоздатьТовары(КоличествоТоваров);
	
	// Создаем клиентов
	СоздатьКлиентов(КоличествоКлиентов);
    
    // Создаем документы продажи
    СоздатьДокументыПродажи(КоличествоДокументов);
    
    Сообщить("Тестовые данные созданы!");
    
КонецПроцедуры

&НаСервере
Процедура СоздатьТовары(Количество)
    
    Для Счетчик = 1 По Количество Цикл
        
        Товар = Справочники.Товары.СоздатьЭлемент();
        Товар.Наименование = "Товар " + Счетчик;
        Товар.Цена = 100 + Счетчик * 10; // Цены от 110 до 1100
		Товар.Записать();
        
    КонецЦикла;
    
    Сообщить("Создано товаров: " + Количество);
    
КонецПроцедуры

&НаСервере
Процедура СоздатьКлиентов(Количество)
    
    Для Счетчик = 1 По Количество Цикл
        
        Клиент = Справочники.Клиенты.СоздатьЭлемент();
        Клиент.Наименование = "Клиент " + Счетчик;
		Клиент.Записать();
        
    КонецЦикла;
    
    Сообщить("Создано клиентов: " + Количество);
    
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыПродажи(Количество)
    
    // Получаем списки товаров и клиентов
    ЗапросТоваров = Новый Запрос;
    ЗапросТоваров.Текст = "ВЫБРАТЬ Товары.Ссылка КАК Ссылка, Товары.Цена КАК Цена ИЗ Справочник.Товары КАК Товары";
    ВыборкаТоваров = ЗапросТоваров.Выполнить().Выгрузить();
    
    ЗапросКлиентов = Новый Запрос;
    ЗапросКлиентов.Текст = "ВЫБРАТЬ Клиенты.Ссылка КАК Ссылка ИЗ Справочник.Клиенты КАК Клиенты";
    ВыборкаКлиентов = ЗапросКлиентов.Выполнить().Выгрузить();
    
    Если ВыборкаТоваров.Количество() = 0 ИЛИ ВыборкаКлиентов.Количество() = 0 Тогда
        Сообщить("Нет товаров или клиентов!");
        Возврат;
    КонецЕсли;
    
    // Создаем документы
    Для Счетчик = 1 По Количество Цикл
        
        Документ = Документы.Продажа.СоздатьДокумент();
        Документ.Дата = ТекущаяДата() - Счетчик * 3600; // Разные даты
		//Документ.Клиент = ВыборкаКлиентов[Счетчик % ВыборкаКлиентов.Количество()].Ссылка;
        
        // Добавляем 3-5 случайных товаров в документ
        КоличествоСтрок = 3 + Счетчик % 3;
        
        Для НомерСтроки = 1 По КоличествоСтрок Цикл
            
            ИндексТовара = (Счетчик + НомерСтроки) % ВыборкаТоваров.Количество();
            СтрокаТовара = Документ.Товары.Добавить();
            СтрокаТовара.Товар = ВыборкаТоваров[ИндексТовара].Ссылка;
            СтрокаТовара.Количество = 1 + Счетчик % 10;
            СтрокаТовара.Цена = ВыборкаТоваров[ИндексТовара].Цена;
            
        КонецЦикла;
        
		Документ.Записать(РежимЗаписиДокумента.Проведение);
        
    КонецЦикла;
    
    Сообщить("Создано и проведено документов: " + Количество);
    
КонецПроцедуры