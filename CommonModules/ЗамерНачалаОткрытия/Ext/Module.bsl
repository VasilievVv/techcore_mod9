// Учебная ошибка: N+1 запросов к регистру накопления.
Функция МедленныйОтчет(НачалоПериода, КонецПериода) Экспорт
    Итог = Новый ТаблицаЗначений;
    Итог.Колонки.Добавить("Товар");
    Итог.Колонки.Добавить("Сумма");
    ВыборкаТоваров = Справочники.Товары.Выбрать();
    Пока ВыборкаТоваров.Следующий() Цикл
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |  СУММА(Обороты.СуммаОборот) КАК Сумма
        |ИЗ РегистрНакопления.ПродажиТоваров.Обороты(&Начало, &Конец, , Товар = &Товар) КАК Обороты";
        Запрос.УстановитьПараметр("Начало", НачалоПериода);
        Запрос.УстановитьПараметр("Конец", КонецПериода);
        Запрос.УстановитьПараметр("Товар", ВыборкаТоваров.Ссылка);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Если ЗначениеЗаполнено(Выборка.Сумма) Тогда
                СтрокаИтога = Итог.Добавить();
                СтрокаИтога.Товар = ВыборкаТоваров.Ссылка;
                СтрокаИтога.Сумма = Выборка.Сумма;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Возврат Итог;
КонецФункции

// Эталонное решение: один запрос с группировкой.
Функция БыстрыйОтчет(НачалоПериода, КонецПериода) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |  Обороты.Товар КАК Товар,
    |  СУММА(Обороты.СуммаОборот) КАК Сумма
    |ИЗ РегистрНакопления.ПродажиТоваров.Обороты(&Начало, &Конец, , ) КАК Обороты
    |СГРУППИРОВАТЬ ПО Обороты.Товар";
    Запрос.УстановитьПараметр("Начало", НачалоПериода);
    Запрос.УстановитьПараметр("Конец", КонецПериода);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
